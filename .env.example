VOICE_ENGINE_HOST=0.0.0.0
VOICE_ENGINE_PORT=8000
VOICE_ENGINE_AUTH_TOKEN=
VOICE_ENGINE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
VOICE_ENGINE_MAX_CONNECTIONS=100
VOICE_ENGINE_MAX_FRAME_BYTES=64000
VOICE_ENGINE_MODE=wideband
VOICE_ENGINE_TELEPHONY_CODEC=pcm_s16le
VOICE_ENGINE_TELEPHONY_VAD_SPEECH_THRESHOLD=0.025
VOICE_ENGINE_TELEPHONY_VAD_SILENCE_THRESHOLD=0.018
VOICE_ENGINE_VAD_SPEECH_THRESHOLD=0.020
VOICE_ENGINE_VAD_SILENCE_THRESHOLD=0.015
VOICE_ENGINE_VAD_MIN_SPEECH_MS=100
VOICE_ENGINE_STT=mock
VOICE_ENGINE_LLM=mock
VOICE_ENGINE_TTS=mock

# Optional SIP lab; tools.setup_freeswitch_lab generates private credentials separately.
VOICE_ENGINE_CALL_LAB_ENABLED=false
VOICE_ENGINE_CALL_LAB_TOKEN=
VOICE_ENGINE_CALL_LAB_SIP_HOST=
VOICE_ENGINE_FREESWITCH_SIP_PORT=5070
VOICE_ENGINE_FREESWITCH_RTP_PORT=5072
VOICE_ENGINE_FREESWITCH_ESL_PORT=8021
VOICE_ENGINE_CALL_LAB_SIP_PORT=5060
VOICE_ENGINE_FREESWITCH_ESL_PASSWORD=
VOICE_ENGINE_FREESWITCH_PLAYOUT_MARGIN_MS=200

# Gemini TTS (VOICE_ENGINE_TTS=gemini) and Gemini LLM (VOICE_ENGINE_LLM=gemini)
# Requires: pip install -e ".[gemini]"
GEMINI_API_KEY=
VOICE_ENGINE_GEMINI_MODEL=gemini-2.5-flash-preview-tts
VOICE_ENGINE_GEMINI_VOICE=Kore
VOICE_ENGINE_GEMINI_LLM_MODEL=gemini-3.6-flash
VOICE_ENGINE_GEMINI_LLM_MAX_TOKENS=200
VOICE_ENGINE_GEMINI_LLM_TEMPERATURE=0.7

# Deepgram Aura TTS (VOICE_ENGINE_TTS=deepgram); requires: pip install -e ".[deepgram]"
DEEPGRAM_API_KEY=
VOICE_ENGINE_DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Local faster-whisper STT (VOICE_ENGINE_STT=faster_whisper); requires: pip install -e ".[whisper]"
# Small multilingual model for initial CPU testing. Larger models are optional.
VOICE_ENGINE_WHISPER_MODEL=base
VOICE_ENGINE_WHISPER_DEVICE=cpu
VOICE_ENGINE_WHISPER_COMPUTE_TYPE=int8
VOICE_ENGINE_WHISPER_LANGUAGE=
VOICE_ENGINE_WHISPER_NO_SPEECH_THRESHOLD=0.6
VOICE_ENGINE_WHISPER_LOGPROB_THRESHOLD=-1.0

# Generic OpenAI-compatible /v1/completions LLM (VOICE_ENGINE_LLM=openai_completions)
# Works with vLLM, text-generation-webui, LM Studio, llama.cpp server, etc.
# Requires: pip install -e ".[openai_completions]"
VOICE_ENGINE_LLM_URL=http://localhost:5000/v1/completions
VOICE_ENGINE_LLM_MODEL=
VOICE_ENGINE_LLM_API_KEY=
VOICE_ENGINE_LLM_SYSTEM_PROMPT="You are a helpful, concise voice assistant. Keep replies short."
VOICE_ENGINE_LLM_MAX_TOKENS=200
VOICE_ENGINE_LLM_TEMPERATURE=0.7
